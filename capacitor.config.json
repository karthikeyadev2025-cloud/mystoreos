{
  "appId": "in.mystoreos.retail",
  "appName": "MyStore OS",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.supabase.co",
      "zdertmpzervgjicuwsfz.supabase.co",
      "mystoreos.in",
      "www.mystoreos.in",
      "wa.me",
      "api.whatsapp.com",
      "*.cloudinary.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#030712",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  },
  "android": {
    "backgroundColor": "#030712",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "appendUserAgent": "MyStoreOS-Android/1.0",
    "minWebViewVersion": 60
  }
}
