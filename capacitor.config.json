{
  "appId": "in.mystoreos.retail",
  "appName": "MyStore OS",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#030712"
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  },
  "android": {
    "backgroundColor": "#030712",
    "webContentsDebuggingEnabled": true
  }
}
