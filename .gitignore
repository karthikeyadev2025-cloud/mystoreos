# Environment secrets — never commit
.env
.env.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tool artifacts (ruflo / claude-flow MCP)
.claude/
.claude-flow/
.swarm/
.agents/
skills-lock.json
ruvector.db
CLAUDE.md

# Stray files created by MCP hook side-effects.
# IMPORTANT: every pattern below is anchored to the repo root with a leading "/"
# so it can ONLY match junk dropped at the top level — it must never silently
# hide real source files inside src/ (e.g. src/lib/api.js, a future a.js, x.ts).
/[a-z]
/[a-z0-9]
/-*
/\(*
/\[*
/api.*
/console.*
/supabase.remove*
/setAuthLoading*
supabase/.temp/

# Belt-and-suspenders: never ignore the real API layer
!src/lib/api.js
