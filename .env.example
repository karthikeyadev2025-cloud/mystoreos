# ============================================================
# MyStore OS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ---- Supabase (required for cloud mode) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Supabase server-side (Edge Functions / webhooks only — never expose to browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Razorpay (Phase 4) ----
# Key ID is safe to expose client-side (prefixed VITE_)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Secret is server-side only — used in webhook handler
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ---- Cron / Edge Function auth ----
# Random secret used to authenticate cron trigger requests to edge functions
CRON_SECRET=replace-with-random-32-char-string

# ---- Sentry (Phase 5 — error tracking) ----
VITE_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX

# ---- WhatsApp Business API (Phase 7) ----
WHATSAPP_TOKEN=your-meta-whatsapp-business-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# WhatsApp Business Cloud API (optional — enables auto-send without opening a browser tab)
# Get token from: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
VITE_WHATSAPP_BUSINESS_TOKEN=
VITE_WHATSAPP_PHONE_NUMBER_ID=

# SMS fallback via MSG91 (optional — used when WhatsApp API is unavailable)
# Get API key from: https://msg91.com
VITE_SMS_API_KEY=
VITE_SMS_SENDER_ID=MYSTR
